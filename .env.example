# ── Database (Neon PostgreSQL) ─────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ── Better Auth ────────────────────────────────────────────────────
# REQUIRED in production: random string, at least 32 characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the site (also used as the auth base URL).
BETTER_AUTH_URL="http://localhost:3000"
# Public site URL used for sitemap/robots/canonical links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Cloudinary (image uploads, direct signed browser upload) ───────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Admin bootstrap (docs/ADMIN-SETUP.md) ──────────────────────────
# Must equal the school-approved admin address; enforced by the script.
ADMIN_BOOTSTRAP_EMAIL=""

# ── Development-only admin (scripts/dev-admin.ts — refuses production) ──
# DEV_ADMIN_EMAIL="devadmin@localhost.test"
# DEV_ADMIN_PASSWORD="dev-admin-password-123"
